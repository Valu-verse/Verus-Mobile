<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon for API 33+ with monochrome for themed icons.
  Foreground: @mipmap/ic_launcher_foreground
  Background: @mipmap/ic_launcher_background
  Monochrome: @mipmap/ic_launcher_monochrome
  Source assets in src/images/customIcons/appIcons/
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome"/>
  </adaptive-icon>


